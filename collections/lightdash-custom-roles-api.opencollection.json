          "http": {
            "method": "GET",
            "url": "/api/v2/orgs/:orgUuid/roles/:roleUuid/assignees",
            "params": [
              {
                "name": "orgUuid",
                "value": "",
                "type": "path"
              },
              {
                "name": "roleUuid",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List the users, groups, and service accounts currently assigned to a role.\nUsed by the delete-confirmation modal to explain why a role cannot\nbe deleted while still in use."
