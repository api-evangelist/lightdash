        {
          "info": {
            "name": "Delete custom role",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/api/v2/orgs/:orgUuid/roles/:roleUuid",
            "params": [
              {
                "name": "orgUuid",
                "value": "",
                "type": "path"
