              },
              {
                "name": "excludeArchived",
                "value": "",
                "type": "query"
              },
              {
                "name": "excludeDms",
                "value": "",
                "type": "query"
              },
              {
                "name": "excludeGroups",
                "value": "",
                "type": "query"
              },
              {
                "name": "forceRefresh",
                "value": "",
                "type": "query"
              },
              {
                "name": "includeChannelIds",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get slack channels"
