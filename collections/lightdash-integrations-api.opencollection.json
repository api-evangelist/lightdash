        {
          "info": {
            "name": "Lookup channel",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/api/v1/slack/channels/:channelId",
            "params": [
              {
                "name": "channelId",
                "value": "",
                "type": "path",
                "description": "Slack channel ID (e.g., C01234567)"
              }
            ]
          },
          "docs": "Look up a single Slack channel by ID. Used for on-demand fetching when\nuser pastes a channel ID not in the cache."
        },
        {
